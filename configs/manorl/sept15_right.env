# Source from the repository root AFTER generating the explicit asset manifest.
# These variables configure a future run; sourcing this file launches nothing.
export MANORL_DATASET_PATH=/mnt/nas-222-project/mocap_v2/lance_datasets/dexgem_vla_demo_cma2lance_20260915_030735.lance
export MANORL_DATASET_VERSION=4
export MANORL_HAND_SIDE=right
export MANORL_DROP_UNCONTROLLED_HANDS=true
export MANORL_REFERENCE_FPS=120
export MANORL_PRE_PADDING=120
export MANORL_POST_PADDING=250
export MANORL_ASSET_MANIFEST="$PWD/outputs/sept15-right/asset_manifest.json"
# train.sh / train_manorl_cube1 default to XYZ 0.002m / 0.01m and five_fingertips.
export MANORL_TARGET_OBJECT_OVERRIDES=egg_cup:04
# v4 has132 rows; explicit action04 target is egg_cup, bowl stays physical.
export MANORL_CONSTRAINT_CAPACITY=2048
export MANORL_CONTACTS_PER_WORLD=512
