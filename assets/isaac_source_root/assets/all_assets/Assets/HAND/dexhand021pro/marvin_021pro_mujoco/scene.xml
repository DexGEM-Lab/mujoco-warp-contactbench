                            <site name="r_index_tac" pos="0 0 0.009" size="0.005" />
                          </body>
                        </body>
                      </body>
                    </body>

                    <!-- 中指: 4 DOF -->
                    <body name="r_middle_base" pos="0.00 0 0.065">
                      <joint name="r_middle_j1" type="hinge" axis="1 0 0" range="-0.3 0.3" />
                      <geom  type="capsule" size="0.011" fromto="0 0 0  0 0 0.026" material="robot_body" />
                      <body name="r_middle_link1" pos="0 0 0.026">
                        <joint name="r_middle_j2" type="hinge" axis="0 1 0" range="0 1.57" />
