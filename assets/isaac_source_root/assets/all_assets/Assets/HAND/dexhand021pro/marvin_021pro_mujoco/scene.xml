              <body name="left_arm_link4" pos="0 0 0.11">
                <joint name="left_arm_j5" type="hinge" axis="0 0 1" range="-2.97 2.97" />
                <geom  type="capsule" size="0.025" fromto="0 0 0  0 0 0.10" material="robot_body" />

                <body name="left_arm_link5" pos="0 0 0.10">
                  <joint name="left_arm_j6" type="hinge" axis="0 1 0" range="-2.09 2.09" />
                  <geom  type="capsule" size="0.025" fromto="0 0 0  0 0 0.08" material="robot_body" />

                  <body name="left_arm_link6" pos="0 0 0.08">
                    <joint name="left_arm_j7" type="hinge" axis="0 0 1" range="-2.97 2.97" />
                    <geom  type="sphere" size="0.04" material="robot_body" />

                    <!-- 左腕相机 -->
                    <camera name="/observe/vision/left_wrist/fisheye/rgb"
                            pos="0 0.05 0.02" euler="1.5708 0 0"
                            fovy="150" />

                    <!-- 左手 (21-DOF, 结构同右手, 镜像) -->
                    <body name="l_thumb_base" pos="-0.03 0 0.05">
                      <joint name="l_thumb_j1" type="hinge" axis="1 0 0" range="-0.5 1.57" />
                      <geom  type="capsule" size="0.012" fromto="0 0 0  0 0 0.03" material="robot_body" />
                      <body name="l_thumb_link1" pos="0 0 0.03">
                        <joint name="l_thumb_j2" type="hinge" axis="0 1 0" range="0 1.57" />
                        <geom  type="capsule" size="0.011" fromto="0 0 0  0 0 0.025" material="robot_body" />
                        <body name="l_thumb_link2" pos="0 0 0.025">
                          <joint name="l_thumb_j3" type="hinge" axis="0 1 0" range="0 1.57" />
                          <geom  type="capsule" size="0.010" fromto="0 0 0  0 0 0.022" material="robot_body" />
                          <body name="l_thumb_link3" pos="0 0 0.022">
                            <joint name="l_thumb_j4" type="hinge" axis="0 1 0" range="0 1.57" />
                            <geom  type="capsule" size="0.009" fromto="0 0 0  0 0 0.018" material="robot_body" />
                            <body name="l_thumb_tip" pos="0 0 0.018">
                              <joint name="l_thumb_j5" type="hinge" axis="0 0 1" range="-0.5 0.5" />
