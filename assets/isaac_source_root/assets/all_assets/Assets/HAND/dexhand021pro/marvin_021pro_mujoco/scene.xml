<!--
  VTLA_021PRO MuJoCo Scene
  ────────────────────────
  机器人配置:
    双臂:  左/右各 7-DOF
    灵巧手: 左/右各 21-DOF (SharpaWave)
    颈部:  2-DOF (yaw + pitch)
    触觉:  每根手指 3 个触觉传感器 (10 根手指 × 3 = 30 个传感器位置)
    相机:  4 路 (头部双目立体 + 双腕鱼眼)

  NOTE: 本文件为模板骨架，关节参数/mesh路径需替换为真实 URDF 导出值。
        替换步骤:
          1. 将机器人 URDF 用 mujoco 工具转换: python -m mujoco.viewer --mjcf=robot.xml
          2. 把各关节的 range/gear/kp 值填入对应 joint/actuator 标签
          3. 把 mesh 文件放入 sim/assets/meshes/ 目录
-->
<mujoco model="vitacformer_scene">

  <!-- ── 全局选项 ──────────────────────────────────────────────────────── -->
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast">
    <flag contact="enable" />
  </option>

  <size njmax="2000" nconmax="500" />

  <!-- ── 资源路径 ──────────────────────────────────────────────────────── -->
  <compiler meshdir="meshes" texturedir="textures" angle="radian" />

  <!-- ── 默认关节/执行器属性 ──────────────────────────────────────────── -->
  <default>
    <joint damping="0.1" armature="0.01" frictionloss="0.01" />
    <geom condim="3" friction="1 0.005 0.0001" />
    <motor ctrllimited="true" ctrlrange="-1 1" gear="1" />
    <camera fovy="60" />
  </default>

  <!-- ── 资源声明 ──────────────────────────────────────────────────────── -->
  <asset>
    <!-- 占位材质 (替换为真实 mesh) -->
    <material name="robot_body" rgba="0.7 0.7 0.7 1" />
    <material name="table"      rgba="0.9 0.8 0.6 1" />
    <material name="finger_tip" rgba="0.3 0.3 0.8 1" />
  </asset>

  <!-- ── 世界 ─────────────────────────────────────────────────────────── -->
  <worldbody>

    <!-- 光源 -->
    <light name="top_light"   pos="0 0 3"    dir="0 0 -1" diffuse="0.8 0.8 0.8" />
    <light name="front_light" pos="1 0 2"    dir="-1 0 -1" diffuse="0.4 0.4 0.4" />

    <!-- 地面 -->
    <geom name="floor" type="plane" size="5 5 0.1" material="table" pos="0 0 0" />

    <!-- 桌面 -->
    <body name="table" pos="0 0 0.4">
      <geom name="table_top" type="box" size="0.8 0.5 0.02" material="table" />
      <!-- 任务物体占位符 (由具体 task 脚本动态添加) -->
    </body>

    <!-- ── 机器人底座 ────────────────────────────────────────────────── -->
    <body name="base" pos="0 -0.5 0.42">
      <geom name="base_geom" type="box" size="0.15 0.15 0.02" material="robot_body" />
      <inertial pos="0 0 0" mass="50" diaginertia="1 1 1" />

      <!-- 颈部 (2-DOF: yaw + pitch) -->
      <body name="neck_yaw_link" pos="0 0 0.5">
        <joint name="neck_yaw"   type="hinge" axis="0 0 1"  range="-1.57 1.57" />
        <geom  name="neck_yaw_geom"  type="cylinder" size="0.04 0.05" material="robot_body" />

        <body name="neck_pitch_link" pos="0 0 0.1">
          <joint name="neck_pitch" type="hinge" axis="0 1 0"  range="-0.5 0.5" />
          <geom  name="neck_pitch_geom" type="cylinder" size="0.03 0.04" material="robot_body" />

          <!-- ── 头部相机 ──────────────────────────────────────────── -->
          <camera name="/observe/vision/head/stereo/lefteye/rgb"
                  pos="-0.03 0.12 0.05" euler="1.5708 0 0"
                  fovy="80" />
          <camera name="/observe/vision/head/stereo/righteye/rgb"
                  pos=" 0.03 0.12 0.05" euler="1.5708 0 0"
                  fovy="80" />
        </body>
      </body>

      <!-- ════════════════════════════════════════════════════════════
           右臂 (7-DOF)
           joint 命名: right_arm_j{1..7}
           ════════════════════════════════════════════════════════════ -->
      <body name="right_arm_link0" pos="0.15 0 0.3">
        <joint name="right_arm_j1" type="hinge" axis="0 0 1" range="-2.97 2.97" />
        <geom  type="capsule" size="0.04" fromto="0 0 0  0 0 0.15" material="robot_body" />

        <body name="right_arm_link1" pos="0 0 0.15">
          <joint name="right_arm_j2" type="hinge" axis="0 1 0" range="-1.76 1.76" />
          <geom  type="capsule" size="0.035" fromto="0 0 0  0 0 0.13" material="robot_body" />

          <body name="right_arm_link2" pos="0 0 0.13">
            <joint name="right_arm_j3" type="hinge" axis="0 0 1" range="-2.97 2.97" />
            <geom  type="capsule" size="0.03" fromto="0 0 0  0 0 0.12" material="robot_body" />

            <body name="right_arm_link3" pos="0 0 0.12">
              <joint name="right_arm_j4" type="hinge" axis="0 1 0" range="-2.09 2.09" />
