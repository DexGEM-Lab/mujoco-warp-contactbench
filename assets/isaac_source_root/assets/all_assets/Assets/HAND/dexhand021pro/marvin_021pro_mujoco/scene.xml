                            <site name="r_middle_tac" pos="0 0 0.009" size="0.005" />
                          </body>
                        </body>
                      </body>
                    </body>

                    <!-- 无名指: 4 DOF -->
                    <body name="r_ring_base" pos="-0.02 0 0.062">
                      <joint name="r_ring_j1" type="hinge" axis="1 0 0" range="-0.3 0.3" />
                      <geom  type="capsule" size="0.010" fromto="0 0 0  0 0 0.024" material="robot_body" />
                      <body name="r_ring_link1" pos="0 0 0.024">
                        <joint name="r_ring_j2" type="hinge" axis="0 1 0" range="0 1.57" />
                        <geom  type="capsule" size="0.009" fromto="0 0 0  0 0 0.020" material="robot_body" />
                        <body name="r_ring_link2" pos="0 0 0.020">
                          <joint name="r_ring_j3" type="hinge" axis="0 1 0" range="0 1.57" />
                          <geom  type="capsule" size="0.008" fromto="0 0 0  0 0 0.017" material="robot_body" />
                          <body name="r_ring_tip" pos="0 0 0.017">
                            <joint name="r_ring_j4" type="hinge" axis="0 1 0" range="0 1.57" />
                            <geom  name="r_ring_tip_geom" type="sphere" size="0.008" material="finger_tip" />
                            <site name="r_ring_tac" pos="0 0 0.008" size="0.005" />
                          </body>
                        </body>
                      </body>
                    </body>

                    <!-- 小指: 4 DOF -->
                    <body name="r_little_base" pos="-0.04 0 0.055">
                      <joint name="r_little_j1" type="hinge" axis="1 0 0" range="-0.3 0.3" />
                      <geom  type="capsule" size="0.009" fromto="0 0 0  0 0 0.022" material="robot_body" />
                      <body name="r_little_link1" pos="0 0 0.022">
                        <joint name="r_little_j2" type="hinge" axis="0 1 0" range="0 1.57" />
                        <geom  type="capsule" size="0.008" fromto="0 0 0  0 0 0.018" material="robot_body" />
                        <body name="r_little_link2" pos="0 0 0.018">
                          <joint name="r_little_j3" type="hinge" axis="0 1 0" range="0 1.57" />
                          <geom  type="capsule" size="0.007" fromto="0 0 0  0 0 0.015" material="robot_body" />
                          <body name="r_little_tip" pos="0 0 0.015">
                            <joint name="r_little_j4" type="hinge" axis="0 1 0" range="0 1.57" />
                            <geom  name="r_little_tip_geom" type="sphere" size="0.007" material="finger_tip" />
                            <site name="r_little_tac" pos="0 0 0.007" size="0.005" />
                          </body>
                        </body>
                      </body>
                    </body>

                  </body><!-- right_arm_link6 -->
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ════════════════════════════════════════════════════════════
           左臂 (7-DOF, 镜像右臂)
           ════════════════════════════════════════════════════════════ -->
      <body name="left_arm_link0" pos="-0.15 0 0.3">
        <joint name="left_arm_j1" type="hinge" axis="0 0 1" range="-2.97 2.97" />
        <geom  type="capsule" size="0.04" fromto="0 0 0  0 0 0.15" material="robot_body" />

        <body name="left_arm_link1" pos="0 0 0.15">
          <joint name="left_arm_j2" type="hinge" axis="0 1 0" range="-1.76 1.76" />
          <geom  type="capsule" size="0.035" fromto="0 0 0  0 0 0.13" material="robot_body" />

          <body name="left_arm_link2" pos="0 0 0.13">
            <joint name="left_arm_j3" type="hinge" axis="0 0 1" range="-2.97 2.97" />
            <geom  type="capsule" size="0.03" fromto="0 0 0  0 0 0.12" material="robot_body" />

            <body name="left_arm_link3" pos="0 0 0.12">
              <joint name="left_arm_j4" type="hinge" axis="0 1 0" range="-2.09 2.09" />
