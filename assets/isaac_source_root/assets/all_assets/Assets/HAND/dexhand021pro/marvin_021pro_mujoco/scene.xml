                      <body name="r_thumb_link1" pos="0 0 0.03">
                        <joint name="r_thumb_j2" type="hinge" axis="0 1 0" range="0 1.57" />
                        <geom  type="capsule" size="0.011" fromto="0 0 0  0 0 0.025" material="robot_body" />
                        <body name="r_thumb_link2" pos="0 0 0.025">
                          <joint name="r_thumb_j3" type="hinge" axis="0 1 0" range="0 1.57" />
                          <geom  type="capsule" size="0.010" fromto="0 0 0  0 0 0.022" material="robot_body" />
                          <body name="r_thumb_link3" pos="0 0 0.022">
                            <joint name="r_thumb_j4" type="hinge" axis="0 1 0" range="0 1.57" />
                            <geom  type="capsule" size="0.009" fromto="0 0 0  0 0 0.018" material="robot_body" />
                            <body name="r_thumb_tip" pos="0 0 0.018">
                              <joint name="r_thumb_j5" type="hinge" axis="0 0 1" range="-0.5 0.5" />
                              <geom  name="r_thumb_tip_geom" type="sphere" size="0.009" material="finger_tip" />
                              <!-- 触觉传感器位点 -->
                              <site name="r_thumb_tac" pos="0 0 0.009" size="0.005" />
                            </body>
                          </body>
                        </body>
                      </body>
                    </body>

                    <!-- 食指: 4 DOF -->
                    <body name="r_index_base" pos="0.02 0 0.06">
