                    <geom  type="sphere" size="0.04" material="robot_body" />

                    <!-- 右腕相机 -->
                    <camera name="/observe/vision/right_wrist/fisheye/rgb"
                            pos="0 0.05 0.02" euler="1.5708 0 0"
                            fovy="150" />

                    <!-- ── 右手 (21-DOF, SharpaWave) ─────────────── -->
                    <!-- 5 根手指, 每根 4 个关节 (拇指 5 个关节) -->
                    <!-- 拇指: 5 DOF -->
                    <body name="r_thumb_base" pos="0.03 0 0.05">
                      <joint name="r_thumb_j1" type="hinge" axis="1 0 0" range="-0.5 1.57" />
