                      <geom  type="capsule" size="0.011" fromto="0 0 0  0 0 0.026" material="robot_body" />
                      <body name="l_middle_link1" pos="0 0 0.026">
                        <joint name="l_middle_j2" type="hinge" axis="0 1 0" range="0 1.57" />
                        <geom  type="capsule" size="0.010" fromto="0 0 0  0 0 0.023" material="robot_body" />
                        <body name="l_middle_link2" pos="0 0 0.023">
                          <joint name="l_middle_j3" type="hinge" axis="0 1 0" range="0 1.57" />
                          <geom  type="capsule" size="0.009" fromto="0 0 0  0 0 0.019" material="robot_body" />
