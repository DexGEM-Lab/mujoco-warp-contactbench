  <!-- ── 执行器 (position control) ──────────────────────────────────────── -->
  <actuator>
    <!-- 颈部 -->
    <position name="act_neck_yaw"   joint="neck_yaw"   kp="50" />
    <position name="act_neck_pitch" joint="neck_pitch" kp="50" />

    <!-- 右臂 -->
    <position name="act_r_arm_j1" joint="right_arm_j1" kp="200" />
    <position name="act_r_arm_j2" joint="right_arm_j2" kp="200" />
    <position name="act_r_arm_j3" joint="right_arm_j3" kp="150" />
